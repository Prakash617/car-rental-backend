# ==========================================
# Backend Environment Configuration
# ==========================================

DEBUG=True
SECRET_KEY=django-insecure-dev-change-in-production-must-be-50-characters-long
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,.platform.com

# --- Database ---
DATABASE_URL=postgres://car_rental_user:secure_dev_password@localhost:5432/car_rental
POSTGRES_DB=car_rental
POSTGRES_USER=car_rental_user
POSTGRES_PASSWORD=secure_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=notifications@platform.com

# --- Storage Provider (local / s3) ---
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# --- Payment Gateways ---
PAYMENT_PROVIDER=stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
ESEWA_MERCHANT_ID=
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
